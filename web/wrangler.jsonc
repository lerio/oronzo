{
  // Deployed from this directory with:  npx wrangler deploy
  //
  // Static assets only — the SPA talks to Supabase directly, so there is no server side to
  // run. Note `directory`: without it wrangler publishes the whole source folder, which
  // "works" while serving the wrong thing entirely.
  //
  // `single-page-application` makes an unknown path serve index.html instead of a 404,
  // which the client-side router needs — otherwise a hard refresh on /plans/<id> breaks.
  "name": "oronzo",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
