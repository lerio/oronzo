# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API Keys -> "Publishable and secret API keys"
#
# Use the PUBLISHABLE key (sb_publishable_...). It is safe in client code: it grants no
# privileges by itself, and row-level security protects every table. Never put the
# secret key (sb_secret_...) here, and never commit .env.local.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
