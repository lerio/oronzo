# --- macOS ---
.DS_Store
._*

# --- Secrets / local config ---
.env
.env.local
.env.*.local
*.local.xcconfig

# --- Node / web (web/) ---
node_modules/
web/dist/
web/.vite/
*.log
npm-debug.log*
yarn-error.log*

# --- Xcode ---
# The .xcodeproj is generated by XcodeGen from ios/project.yml — never commit it.
ios/*.xcodeproj/
# Local, uncommitted config: signing team ID + Supabase project ref and key.
# Copy ios/Local.private.xcconfig.example to create it. The committed ios/Local.xcconfig
# includes this file optionally, so a fresh clone still builds.
ios/Local.private.xcconfig
xcuserdata/
*.xcuserstate
DerivedData/
build/
# SwiftPM's build directory. Note this is `.build/`, NOT `build/` — gitignore patterns
# match on the exact name, so the `build/` line above does not cover it.
.build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM/
.swiftpm/

# --- Supabase local dev ---
supabase/.temp/
supabase/.branches/

# Cloudflare Workers local state and secrets
ops/**/.wrangler/
ops/**/.dev.vars

# --- Claude Code ---
# Personal, uncommitted overrides (in-session "don't ask again" approvals land here).
# Claude Code adds this to your *global* git excludes when it creates the file itself, which
# is not enough for a public repo — so the rule is stated here too.
.claude/settings.local.json
