# --- macOS ---
.DS_Store
._*

# --- Secrets / local config ---
.env
.env.local
.env.*.local
*.local.xcconfig

# --- Node / web (web/) ---
node_modules/
web/dist/
web/.vite/
*.log
npm-debug.log*
yarn-error.log*

# --- Xcode ---
# The .xcodeproj is generated by XcodeGen from ios/project.yml — never commit it.
ios/*.xcodeproj/
# Local signing identity (team ID). Copy ios/Signing.xcconfig.example to create it.
ios/Signing.xcconfig
xcuserdata/
*.xcuserstate
DerivedData/
build/
# SwiftPM's build directory. Note this is `.build/`, NOT `build/` — gitignore patterns
# match on the exact name, so the `build/` line above does not cover it.
.build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM/
.swiftpm/

# --- Supabase local dev ---
supabase/.temp/
supabase/.branches/
