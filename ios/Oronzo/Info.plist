<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Oronzo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!--
	  Backend config, substituted at build time from ios/Local.xcconfig (gitignored) so no
	  account-specific values are published. Empty values are what a fresh clone gets: the
	  app builds and runs, and reports clearly at runtime that it is unconfigured rather
	  than failing in a confusing way.
	-->
	<key>SupabaseProjectRef</key>
	<string>$(SUPABASE_PROJECT_REF)</string>
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<!--
	  Required for any HealthKit *write* request, and its absence is a hard crash rather than a
	  silent failure — so this string is load-bearing, not documentation. There is deliberately no
	  NSHealthShareUsageDescription: Oronzo requests write access to workouts and reads nothing
	  back, and a usage string for a permission that is never asked for is a lie in the app's own
	  metadata. See ios/Oronzo/Oronzo.entitlements.
	-->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Oronzo adds your finished workouts to Apple Health so they appear in the Fitness app.</string>
	<!-- Keeps the session engine alive while the phone is in a pocket. See docs/decisions.md. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
