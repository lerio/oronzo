// Copy this file to `Signing.xcconfig` (which is gitignored) and fill in your team ID.
//
//   cp ios/Signing.xcconfig.example ios/Signing.xcconfig
//
// Find your team ID — it is the OU= field of your Apple Development certificate:
//
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
//
// Expected output looks like:
//   subject=UID=XXXXXXXXXX, CN=Apple Development: you@example.com (YYYYYYYYYY),
//           OU=ZZZZZZZZZZ, O=Your Name, C=US
//                                ^^^^^^^^^^ team ID
//
// A free "personal team" works fine (it is what this project is developed against) —
// it just expires provisioning profiles every 7 days, so you re-run from Xcode weekly.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
